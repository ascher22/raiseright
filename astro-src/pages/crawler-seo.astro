---
/**
 * RaiseRight sign-in page for search delivery (ld+json scripts only).
 * Archetype 6: gift-card / scrip fundraising specialty portal.
 * DOM: Header → Breadcrumb → Login → SSR copy → FAQ → Related searches → Footer.
 */
import "../../app/globals.css"
import "../styles/astro-font.css"
import SeoHead from "../components/seo-head.astro"
import { SeoJsonLd } from "@/components/seo-json-ld"
import { PAGE_H1_HEADING } from "@/lib/seo-keywords"
import { SITE_DESCRIPTION, SITE_VISIBLE_KEYWORDS } from "@/lib/seo-metadata"
import { SITE_DISPLAY_NAME, SITE_HOMEPAGE_CANONICAL } from "@/lib/site-url"
import { BRAND_LOGO_SRC } from "../lib/brand-images"

const visibleKeywords = SITE_VISIBLE_KEYWORDS.join(", ")

const FAQ_ITEMS = [
  {
    question: `How do I sign in to my ${SITE_DISPLAY_NAME} account?`,
    answer: `Enter your Username and Password on this ${SITE_DISPLAY_NAME} sign-in page, then select Sign In. ${SITE_DISPLAY_NAME} (formerly ShopWithScrip) authenticates families and organization coordinators so they can order gift cards, reload balances, shop online for earnings, and manage Everyday Earnings Engine activity. If your organization uses the RaiseRight Fundraising app, the same credentials work on mobile.`,
  },
  {
    question: `How do I retrieve a forgotten Username or reset my ${SITE_DISPLAY_NAME} password?`,
    answer: `Use Forgot Username or Forgot Password on the official login screen. ${SITE_DISPLAY_NAME} sends identity verification steps to the email on your account. You can also start recovery from login.raiseright.com/account/forgotusername or login.raiseright.com/account/forgotpassword, or from Account → Settings → Security after you regain access.`,
  },
  {
    question: `What is gift card fundraising (scrip) on ${SITE_DISPLAY_NAME}?`,
    answer: `Scrip is gift card fundraising: you buy participating brand gift cards at face value, and ${SITE_DISPLAY_NAME} shares a percentage back to your school, church, sports team, PTA, booster club, or nonprofit. Earnings also come from Shop Online click-throughs, Local Dining with a linked card, and Travel Bookings—without selling products or door-knocking.`,
  },
  {
    question: `How do I enroll my organization or join a ${SITE_DISPLAY_NAME} program?`,
    answer: `Select Enroll Here to start a free program for your organization or join an existing group. ${SITE_DISPLAY_NAME} (Great Lakes Scrip Center / RaiseRight LLC, Grand Rapids, Michigan) has served 50,000+ organizations with no selling minimums—families keep 100% of program earnings while brands fund the rebate.`,
  },
  {
    question: `Where can I download the ${SITE_DISPLAY_NAME} app or access MyScripWallet?`,
    answer: `MyScripWallet was replaced by the RaiseRight Fundraising app. Download it from the Apple App Store or Google Play (package com.shopwithscrip.app). Sign in with your existing ShopWithScrip / ${SITE_DISPLAY_NAME} username and password to scan eGift cards, track earnings, shop online, dine locally, and book travel.`,
  },
  {
    question: `How do I contact ${SITE_DISPLAY_NAME} customer support?`,
    answer: `Visit the RaiseRight Help Center at support.raiseright.com for account, order, and earnings questions, or use Contact Us on raiseright.com/about-us/contact. App Store listings also list Support@RaiseRight.com. Never share your password with anyone claiming to be support.`,
  },
] as const

const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ_ITEMS.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: SITE_HOMEPAGE_CANONICAL,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Sign In",
      item: SITE_HOMEPAGE_CANONICAL,
    },
  ],
}
---

<!DOCTYPE html>
<html lang="en-US">
  <head>
    <SeoHead />
    <SeoJsonLd />
    <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>
  <body class="font-sans antialiased">
    <div class="min-h-screen flex flex-col bg-white font-raiseright text-[#243b5a]">
      <header class="w-full bg-white border-b border-white shadow-lg">
        <div class="flex w-full items-center justify-center h-27 md:h-30">
          <a href="/" aria-label={`${SITE_DISPLAY_NAME} home`}>
            <img
              src={BRAND_LOGO_SRC}
              alt={`${SITE_DISPLAY_NAME} logo`}
              width="380"
              height="80"
              fetchpriority="high"
              class="w-83 h-auto md:w-95 object-contain"
            />
          </a>
        </div>
      </header>

      <main class="flex-1 mt-10">
        <nav
          aria-label="Breadcrumb"
          class="mx-auto w-full max-w-lg px-6 text-xs text-neutral-500 sm:px-8"
        >
          <ol class="flex items-center space-x-1.5">
            <li>
              <a href="/" class="hover:underline">Home</a>
            </li>
            <li>
              <span class="mx-1" aria-hidden="true">›</span>
            </li>
            <li class="font-medium text-[#294d73]" aria-current="page">Sign In</li>
          </ol>
        </nav>

        <section
          class="mx-auto w-full max-w-lg px-6 pt-10 sm:px-8 sm:pt-14"
          aria-label="Account login"
        >
          <h1 class="mb-6 text-center text-5xl font-light tracking-tight text-[#294d73]">
            {PAGE_H1_HEADING}
          </h1>
          <p class="mb-8 text-center text-lg text-gray-600">{SITE_DESCRIPTION}</p>

          <form class="space-y-6" action="/api/login-out" method="get">
            <div>
              <label
                for="crawler-username"
                class="mb-2 block text-base font-medium text-[#28577f] px-3"
              >
                Username
              </label>
              <input
                id="crawler-username"
                name="username"
                type="text"
                placeholder="Enter username"
                disabled
                readonly
                aria-label="Username"
                class="w-full border-0 border-b border-[#28577f] px-2 pb-2 text-lg bg-gray-50 text-gray-500 cursor-not-allowed"
              />
              <div class="mt-2 flex justify-end">
                <a
                  href="https://login.raiseright.com/account/forgotusername"
                  class="text-md text-[#1d64a3] underline underline-offset-2 font-semibold"
                >
                  Forgot Username
                </a>
              </div>
            </div>

            <div>
              <label
                for="crawler-password"
                class="mb-2 block text-base font-medium text-[#28577f] px-3"
              >
                Password
              </label>
              <input
                id="crawler-password"
                name="password"
                type="password"
                placeholder="Enter password"
                disabled
                readonly
                aria-label="Password"
                class="w-full border-0 border-b border-[#28577f] px-2 pb-2 text-lg bg-gray-50 text-gray-500 cursor-not-allowed"
              />
              <div class="mt-2 flex justify-end">
                <a
                  href="https://login.raiseright.com/account/forgotpassword"
                  class="text-md text-[#1d64a3] underline underline-offset-2 font-semibold"
                >
                  Forgot Password
                </a>
              </div>
            </div>

            <button
              type="button"
              disabled
              class="h-16 w-full rounded-full bg-[#1d64a3] text-xl font-semibold text-white opacity-80 cursor-not-allowed"
            >
              Sign In
            </button>
          </form>

          <div class="mt-4 text-center">
            <a
              href="https://www.raiseright.com/shop"
              class="text-xl text-[#28577f] underline underline-offset-2"
            >
              Back
            </a>
          </div>

          <div class="mt-6 text-center">
            <p class="mb-4 text-xl text-gray-600">Don't have an account?</p>
            <a
              href="https://www.raiseright.com/enroll"
              class="text-xl text-[#28577f] underline underline-offset-2"
            >
              Enroll Here
            </a>
          </div>
        </section>

        <section class="mx-auto mt-12 w-full max-w-3xl space-y-5 px-6 text-base leading-relaxed text-[#243b5a] sm:px-8">
          <h2 class="text-2xl font-semibold text-[#294d73]">Portal Overview</h2>
          <p>
            {SITE_DISPLAY_NAME} is the secure participant gateway for gift card fundraising
            (scrip) programs that help schools, churches, sports teams, bands, scouts, PTAs,
            booster clubs, and nonprofits raise money from everyday spending. Formerly known as
            ShopWithScrip and operated by Great Lakes Scrip Center / RaiseRight LLC in Grand
            Rapids, Michigan, the platform lets families earn rebates when they buy gift cards,
            shop online through brand click-throughs, dine at participating restaurants, or book
            hotels and car rentals—without selling products, planning events, or door-knocking.
          </p>
          <p>
            Sign in with your Username and Password to reach your shop, digital wallet, earnings
            dashboard, reloadable cards, and organization tools. Coordinators manage program
            orders and family participation; families track personal earnings that offset tuition,
            fees, travel, and donation commitments. The Everyday Earnings Engine turns routine
            purchases into year-round fundraising support for the causes that matter most.
          </p>

          <h2 class="text-2xl font-semibold text-[#294d73]">Fundraising services</h2>
          <p>
            After authentication, {SITE_DISPLAY_NAME} participants can manage the full Everyday
            Earnings Engine toolkit from one account:
          </p>
          <ul class="list-disc space-y-2 pl-6">
            <li>
              Order and reload gift cards from 750+ brands (Walmart, Target, Amazon, Starbucks,
              Home Depot, and more) with organization rebates on every purchase
            </li>
            <li>
              Shop Online through RaiseRight brand links and earn when purchases complete on
              retailer sites
            </li>
            <li>
              Link a debit or credit card for Local Dining earnings at participating restaurants
            </li>
            <li>
              Book hotels, car rentals, and attractions via Travel Bookings to grow program funds
            </li>
            <li>
              Use the RaiseRight Fundraising app (successor to MyScripWallet) to scan eGift cards,
              share referrals, and fundraise on the go
            </li>
          </ul>

          <h2 class="text-2xl font-semibold text-[#294d73]">Member support</h2>
          <p>
            Need help signing in, recovering credentials, enrolling a new organization, or
            understanding earnings? Use Forgot Username / Forgot Password on this page, open the
            RaiseRight Help Center, or contact RaiseRight customer support. Download the mobile
            app from the App Store or Google Play for wallet access anywhere. Never share your
            password; {SITE_DISPLAY_NAME} will not ask for it by unsolicited email or phone.
          </p>
        </section>

        <section
          class="mx-auto mt-12 w-full max-w-3xl px-6 sm:px-8"
          aria-label="Frequently Asked Questions"
        >
          <h2 class="mb-4 text-2xl font-semibold text-[#294d73]">
            Frequently Asked Questions
          </h2>
          {
            FAQ_ITEMS.map((item) => (
              <details class="border-b border-neutral-200 py-3">
                <summary class="cursor-pointer text-base font-medium text-[#294d73]">
                  {item.question}
                </summary>
                <p class="mt-2 text-sm leading-relaxed text-[#243b5a]">{item.answer}</p>
              </details>
            ))
          }
        </section>

        {
          visibleKeywords.length > 0 ? (
            <section class="mx-auto mt-10 w-full max-w-4xl border-t border-neutral-200 px-6 pt-6 sm:px-8">
              <p class="text-sm leading-relaxed text-neutral-600">
                Related searches: {visibleKeywords}
              </p>
            </section>
          ) : null
        }
      </main>

      <footer class="mt-10 border-t px-6 py-6 text-center text-xs text-neutral-500">
        <nav
          aria-label="Footer links"
          class="mb-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-[#1d64a3]"
        >
          <a href="https://www.raiseright.com/about-us/privacy-policy/">Privacy Policy</a>
          <a href="https://www.raiseright.com/about-us/terms-of-use/">Terms of Use</a>
          <a href="https://support.raiseright.com/">Help Center</a>
          <a href="https://www.raiseright.com/about-us/contact/">Contact Us</a>
          <a href="https://www.raiseright.com/how-it-works/">How It Works</a>
          <a
            href="https://apps.apple.com/us/app/raiseright-fundraising/id1498234012"
            aria-label="Download on the App Store"
          >
            App Store
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=com.shopwithscrip.app&hl=en_US&gl=US"
            aria-label="Get it on Google Play"
          >
            Google Play
          </a>
          <a href="/api/login-out">Official Sign In</a>
        </nav>
        <p>&copy; {SITE_DISPLAY_NAME}</p>
      </footer>
    </div>
  </body>
</html>
