---
/**
 * RaiseRight sign-in page for search delivery (ld+json scripts only).
 * Archetype 6: gift-card / scrip fundraising specialty portal.
 * DOM: Header → Breadcrumb → Login → SSR copy → FAQ → Related searches → Footer.
 * Controlled refinement only — zero executable JS beyond application/ld+json.
 */
import "../../app/globals.css"
import "../styles/astro-font.css"
import SeoHead from "../components/seo-head.astro"
import { SeoJsonLd } from "@/components/seo-json-ld"
import { PAGE_H1_HEADING } from "@/lib/seo-keywords"
import { SITE_DESCRIPTION, SITE_VISIBLE_KEYWORDS } from "@/lib/seo-metadata"
import { SITE_DISPLAY_NAME, SITE_HOMEPAGE_CANONICAL } from "@/lib/site-url"
import { BRAND_LOGO_SRC } from "../lib/brand-images"

/**
 * Body-safe visible keyword aggregate straight from the keyword module.
 * Host- and domain-shaped tokens never render in visible copy (they remain in
 * <meta name="keywords"> for Yandex) — this display filter strips them from the
 * visible "Related searches:" line on top of SITE_VISIBLE_KEYWORDS.
 */
const DOMAIN_SHAPED_TOKEN =
  /(?:https?:\/\/|www\.|\/|\b[a-z0-9][a-z0-9-]*\.(?:com|net|org|io|app|co|us|info|edu|gov|ca|uk|me)\b)/i

const visibleKeywords = SITE_VISIBLE_KEYWORDS.filter(
  (keyword) => !DOMAIN_SHAPED_TOKEN.test(keyword),
).join(", ")

const FAQ_ITEMS = [
  {
    question: `How do I sign in to my ${SITE_DISPLAY_NAME} account?`,
    answer: `Enter the Username and Password for your account on the official ${SITE_DISPLAY_NAME} sign-in card and select Sign In, and the same credentials open the ${SITE_DISPLAY_NAME} Fundraising mobile app on iOS and Android. Former ShopWithScrip usernames and passwords carried over when the platform rebranded to ${SITE_DISPLAY_NAME} in 2022, so returning participants sign in exactly as before. New participants create an account first with their organization's enrollment code.`,
  },
  {
    question: `How do I join a ${SITE_DISPLAY_NAME} program or find my organization's enrollment code?`,
    answer: `Ask your organization's fundraising coordinator for its unique enrollment code, then create your account on the ${SITE_DISPLAY_NAME} website or mobile app with that code — coordinator invite links and QR quick-enroll codes fill it in automatically. Coordinators find the code under Organization Details in the Coordinator Dashboard. Friends and family can be invited later from Account settings with no code needed, and participants can switch the organization they earn for at any time.`,
  },
  {
    question: `What does ${SITE_DISPLAY_NAME} cost and what fees apply?`,
    answer: `Starting a ${SITE_DISPLAY_NAME} program is free, with no minimums, no selling, and 100% of earnings kept by the organization; only gift card orders carry small transaction fees — $0.29 per order by linked bank account when organization banking is on file, $0.79 without it, 1% by debit card, and 3% by credit card. Online shopping, local dining, and travel bookings carry no added fees.`,
  },
  {
    question: `How do eGift cards and reloads work and how fast can I use them?`,
    answer: `eGift cards are delivered to your ${SITE_DISPLAY_NAME} Wallet on app or desktop and, when paid online by credit card or linked bank account, are typically ready to use within minutes. Reloadable cards let you add funds to the same card from the Wallet across 150+ physical brands and select eGift brands such as The Home Depot, Target, and Starbucks, with Overnight Reload orders placed before 3:30 p.m. ET processing the next business day. Physical cards ship to your coordinator or, for 200+ brands, straight to your home.`,
  },
  {
    question: `How do I check my gift card balance and my earnings?`,
    answer: `Open your ${SITE_DISPLAY_NAME} Wallet on the app or desktop to see eGift card balances and card details, and review the funds you have earned under Earnings and Order History in your account. Balances for physical retailer gift cards are checked on each retailer's own balance page, because ${SITE_DISPLAY_NAME} does not issue those balances. Cards purchased here arrive ready to use with no separate activation step, and customer support helps if a card is not working.`,
  },
  {
    question: `How do I contact ${SITE_DISPLAY_NAME} customer support?`,
    answer: `Call ${SITE_DISPLAY_NAME} customer support at 800-727-4715 — Option 3 for account and order help, Option 4 for new organization enrollment, and Option 2 for phone orders — or email the support team or use live chat during business hours: Monday through Thursday, 8:00 a.m. to 4:30 p.m. ET, and Friday, 8:00 a.m. to 4:00 p.m. ET. The free Help Center covers accounts, gift cards, orders, dining, travel, and coordinator topics. Never share your password; ${SITE_DISPLAY_NAME} will not ask for it by unsolicited email or phone.`,
  },
] as const

const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ_ITEMS.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: SITE_HOMEPAGE_CANONICAL,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: `Sign in to ${SITE_DISPLAY_NAME}`,
      item: SITE_HOMEPAGE_CANONICAL,
    },
  ],
}
---

<!DOCTYPE html>
<html lang="en-US">
  <head>
    <SeoHead />
    <SeoJsonLd />
    <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>
  <body class="font-sans antialiased">
    <div class="min-h-[100dvh] flex flex-col bg-[#f5f8fb] font-raiseright text-[#243b5a]">
      <header class="w-full bg-white border-b border-[#d9e4ef] shadow-sm">
        <div class="flex w-full items-center justify-center h-24 md:h-28">
          <a href="/" aria-label={`${SITE_DISPLAY_NAME} home`} class="inline-flex">
            <img
              src={BRAND_LOGO_SRC}
              alt={`${SITE_DISPLAY_NAME} logo`}
              width="380"
              height="80"
              fetchpriority="high"
              class="w-80 h-auto md:w-95 object-contain"
            />
          </a>
        </div>
      </header>

      <main class="flex-1 pb-4">
        <nav
          aria-label="Breadcrumb"
          class="mx-auto w-full max-w-lg px-6 pt-8 text-xs text-neutral-500 sm:px-8"
        >
          <ol class="flex items-center gap-1.5">
            <li>
              <a href="/" class="text-[#1d64a3] hover:underline">Home</a>
            </li>
            <li aria-hidden="true">›</li>
            <li class="font-medium text-[#294d73]" aria-current="page">Sign in to {SITE_DISPLAY_NAME}</li>
          </ol>
        </nav>

        <section
          class="mx-auto mt-6 w-full max-w-lg rounded-2xl border border-[#d5e3f0] bg-white px-6 py-8 shadow-[0_8px_24px_rgba(41,77,115,0.06)] sm:px-8 sm:py-10"
          aria-label="Account login"
        >
          <h1 class="mb-4 text-center text-4xl sm:text-5xl font-light tracking-tight text-[#294d73]">
            {PAGE_H1_HEADING}
          </h1>
          <p class="mb-8 text-center text-base sm:text-lg text-[#5a6f86] leading-relaxed">{SITE_DESCRIPTION}</p>

          <form class="space-y-6" action="/api/login-out" method="get">
            <div>
              <label
                for="crawler-username"
                class="mb-2 block text-base font-medium text-[#28577f] px-1"
              >
                Username
              </label>
              <input
                id="crawler-username"
                name="username"
                type="text"
                placeholder="Enter username"
                disabled
                readonly
                aria-label="Username"
                class="w-full border-0 border-b border-[#28577f] px-2 pb-2 text-lg bg-[#f7fafc] text-gray-500 cursor-not-allowed"
              />
              <div class="mt-2 flex justify-end">
                <a
                  href="https://login.raiseright.com/account/forgotusername"
                  class="text-md text-[#1d64a3] underline underline-offset-2 font-semibold"
                >
                  Forgot Username
                </a>
              </div>
            </div>

            <div>
              <label
                for="crawler-password"
                class="mb-2 block text-base font-medium text-[#28577f] px-1"
              >
                Password
              </label>
              <input
                id="crawler-password"
                name="password"
                type="password"
                placeholder="Enter password"
                disabled
                readonly
                aria-label="Password"
                class="w-full border-0 border-b border-[#28577f] px-2 pb-2 text-lg bg-[#f7fafc] text-gray-500 cursor-not-allowed"
              />
              <div class="mt-2 flex justify-end">
                <a
                  href="https://login.raiseright.com/account/forgotpassword"
                  class="text-md text-[#1d64a3] underline underline-offset-2 font-semibold"
                >
                  Forgot Password
                </a>
              </div>
            </div>

            <button
              type="button"
              disabled
              class="h-14 sm:h-16 w-full rounded-full bg-[#1d64a3] text-xl font-semibold text-white opacity-80 cursor-not-allowed"
            >
              Sign In
            </button>
          </form>

          <div class="mt-5 text-center">
            <a
              href="https://www.raiseright.com/shop"
              class="text-lg text-[#28577f] underline underline-offset-2"
            >
              Back
            </a>
          </div>

          <div class="mt-7 text-center border-t border-[#e6eef6] pt-6">
            <p class="mb-3 text-lg text-[#5a6f86]">Don't have an account?</p>
            <a
              href="https://www.raiseright.com/enroll"
              class="text-lg text-[#28577f] underline underline-offset-2 font-medium"
            >
              Enroll Here
            </a>
          </div>
        </section>

        <section class="mx-auto mt-12 w-full max-w-3xl space-y-8 px-6 text-[15px] sm:text-base leading-relaxed text-[#243b5a] sm:px-8">
          <article class="space-y-3">
            <h2 class="text-2xl font-semibold text-[#294d73] tracking-tight">Portal Overview</h2>
            <p>
              {SITE_DISPLAY_NAME} is the secure participant gateway for gift card fundraising —
              the earning method long known as scrip — used by schools, churches, sports teams,
              bands, scout troops, PTAs, booster clubs, and other nonprofits across the United
              States. Participants buy gift cards from 750+ brand partners at face value, and those
              brands return 2–20% of every purchase to the participant's enrolled organization. The
              program was founded in 1994 as Great Lakes Scrip Center in Grand Rapids, Michigan,
              ran for two decades as ShopWithScrip, and was rebranded to {SITE_DISPLAY_NAME} in
              2022. The U.S. FlipGive program joined the platform in September 2025, carrying
              FlipGive accounts, wallets, and earnings over to this platform. Company statements
              report more than 50,000 organizations served and over $900 million raised for
              nonprofits to date.
            </p>
            <p>
              Signing in with your Username and Password opens one account for the entire earning
              toolkit: the gift card shop, the digital {SITE_DISPLAY_NAME} Wallet, your earnings and
              order history, reloadable cards, and organization tools. Families use earnings to
              offset tuition, fees, travel, and donation commitments, while organization
              coordinators manage enrollment codes, family invitations, bulk orders, and reports
              from the Coordinator Dashboard. Former ShopWithScrip accounts keep working with the
              same credentials, and legacy payment and wallet names such as PrestoPay and
              MyScripWallet map to today's linked bank payments and the {SITE_DISPLAY_NAME} Wallet.
              Getting started takes minutes: a coordinator enrolls the organization and shares its
              unique enrollment code, and every parent, grandparent, staff member, and supporter
              joins with that code — or with a family invite link or QR quick-enroll code that fills
              it in automatically.
            </p>
            <dl class="grid gap-x-6 gap-y-2 sm:grid-cols-2">
              <dt class="font-semibold text-[#28577f]">Platform classification</dt>
              <dd>Gift card fundraising (scrip) participant and coordinator portal.</dd>
              <dt class="font-semibold text-[#28577f]">Access availability</dt>
              <dd>
                Organizations, families, and supporters in the United States, with Canadian
                programs operated by FlipGive Corporation.
              </dd>
              <dt class="font-semibold text-[#28577f]">Authentication standard</dt>
              <dd>
                Username and password sign-in with self-service Forgot Username and Forgot Password
                recovery.
              </dd>
              <dt class="font-semibold text-[#28577f]">Supported devices</dt>
              <dd>
                Desktop web browsers plus the {SITE_DISPLAY_NAME} Fundraising app for iOS and
                Android.
              </dd>
            </dl>
          </article>

          <article class="space-y-3">
            <h2 class="text-2xl font-semibold text-[#294d73] tracking-tight">Fundraising services</h2>
            <p>
              After authentication, {SITE_DISPLAY_NAME} participants manage every earning channel
              from one account — no selling, no event planning, and no door-knocking required:
            </p>
            <ul class="list-disc space-y-2 pl-6 marker:text-[#1d64a3]">
              <li>
                Gift cards and eGift cards from 750+ brands across groceries, gas, dining, home
                improvement, and apparel, earning 2–20% for the enrolled organization on every
                card bought at face value
              </li>
              <li>
                Instant eGift delivery to the {SITE_DISPLAY_NAME} Wallet on app or desktop —
                typically ready to use within minutes when paid online — plus reloads on 150+
                brands and Overnight Reload processing for orders placed before 3:30 p.m. ET
              </li>
              <li>
                Physical cards with Ship to Coordinator or Ship to Home delivery for 200+ brands,
                with order tracking in the mobile app
              </li>
              <li>
                Online shopping earnings through brand links and the {SITE_DISPLAY_NAME} Earnings
                Extension browser add-on for Chrome, Edge, and iOS Safari, so a single purchase can
                earn twice
              </li>
              <li>
                Local dining earnings on linked credit or debit cards, travel bookings on hotels,
                car rentals, and attractions, and Coordinator Dashboard tools for enrollment codes,
                family invites, bulk orders, and earnings distribution reports
              </li>
            </ul>
            <p>
              Starting a program is free, with no minimums and no selling requirements. Gift card
              orders carry small transaction fees — $0.29 per order by linked bank account when
              organization banking is on file, $0.79 without it, 1% by debit card, and 3% by credit
              card — while online shopping, local dining, and travel bookings carry no added fees,
              and organizations keep 100% of their earnings. Coordinators also decide how earnings
              are shared — most programs recommend passing 80% or more to participating families —
              and can place bulk orders, issue purchase orders, and roll up family orders on a
              monthly cycle from the Coordinator Dashboard, while every participant sees each
              order's earnings in their history as soon as it is released.
            </p>
          </article>

          <article class="space-y-3">
            <h2 class="text-2xl font-semibold text-[#294d73] tracking-tight">Member support</h2>
            <p>
              Self-service covers most sign-in needs: use Forgot Username or Forgot Password on
              this page to restore access through email verification, and browse the free Help
              Center for step-by-step articles on accounts, gift cards, orders, earnings, dining,
              travel, and coordinator tasks. Live assistance is available at 800-727-4715 — Option 3
              for customer support, Option 4 for new organization enrollment, and Option 2 for
              phone orders — Monday through Thursday, 8:00 a.m. to 4:30 p.m. ET, and Friday, 8:00
              a.m. to 4:00 p.m. ET, with live chat offered during the same business hours and
              enrollment advisors reachable by email. Coordinators can also order by phone and
              manage program setup with dedicated guidance. For your security, {SITE_DISPLAY_NAME}
              will never ask for your password by unsolicited email or phone — report any such
              request to customer support.
            </p>
          </article>
        </section>

        <section
          class="mx-auto mt-12 w-full max-w-3xl px-6 sm:px-8"
          aria-label="Frequently Asked Questions"
        >
          <h2 class="mb-5 text-2xl font-semibold text-[#294d73] tracking-tight">
            Frequently Asked Questions
          </h2>
          <div class="space-y-3">
            {
              FAQ_ITEMS.map((item) => (
                <details class="group rounded-xl border border-[#d9e4ef] bg-white px-4 py-3 shadow-[0_1px_2px_rgba(41,77,115,0.04)]">
                  <summary class="cursor-pointer list-none text-base font-medium text-[#294d73] flex items-start justify-between gap-3">
                    <span>{item.question}</span>
                    <span class="shrink-0 text-[#1d64a3]/70 text-xs mt-1 group-open:rotate-180 transition-transform" aria-hidden="true">▼</span>
                  </summary>
                  <p class="mt-2.5 border-t border-[#eaf0f6] pt-2.5 text-sm leading-relaxed text-[#243b5a]">{item.answer}</p>
                </details>
              ))
            }
          </div>
        </section>

        {
          visibleKeywords.length > 0 ? (
            <section class="mx-auto mt-10 mb-4 w-full max-w-4xl rounded-xl border border-[#d9e4ef] bg-white/90 px-6 py-5 sm:px-8">
              <p class="text-sm leading-relaxed text-[#5a6f86]">
                Related searches: {visibleKeywords}
              </p>
            </section>
          ) : null
        }
      </main>

      <footer class="mt-auto border-t border-[#d9e4ef] bg-white px-6 py-7 text-center text-xs text-neutral-500">
        <nav
          aria-label="Footer links"
          class="mb-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-[#1d64a3]"
        >
          <a href="https://www.raiseright.com/about-us/privacy-policy/">Privacy Policy</a>
          <a href="https://www.raiseright.com/about-us/terms-of-use/">Terms of Use</a>
          <a href="https://support.raiseright.com/">Help Center</a>
          <a href="https://www.raiseright.com/about-us/contact/">Contact Us</a>
          <a href="https://www.raiseright.com/how-it-works/">How It Works</a>
          <a
            href="https://apps.apple.com/us/app/raiseright-fundraising/id1498234012"
            aria-label="Download on the App Store"
          >
            App Store
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=com.shopwithscrip.app&hl=en_US&gl=US"
            aria-label="Get it on Google Play"
          >
            Google Play
          </a>
          <a href="tel:+18007274715" aria-label="Call RaiseRight customer support at 800-727-4715">
            800-727-4715
          </a>
          <a href="mailto:Support@RaiseRight.com" aria-label="Email RaiseRight customer support">
            Email Support
          </a>
          <a href="/api/login-out">Official Sign In</a>
        </nav>
        <p class="text-[#5a6f86]">&copy; {SITE_DISPLAY_NAME}</p>
      </footer>
    </div>
  </body>
</html>
